<section class="hero" data-section-id="{{ section.id }}">

  <!-- ░░ Background path / liquid stream decoration ░░ -->
  <div class="hero__bg" aria-hidden="true">
    <svg class="hero__path-svg" viewBox="0 0 1440 720" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="pathBlur">
          <feGaussianBlur stdDeviation="2"/>
        </filter>
      </defs>
      <!-- Liquid stream fill — slightly darker than bg, organic blob feel -->
      <path
        d="M 60 590 C 120 540 200 610 310 572 C 420 534 480 460 600 472 C 720 484 780 540 900 510 C 1020 480 1100 400 1220 418 C 1320 434 1400 475 1500 458"
        stroke="#D4B896"
        stroke-width="28"
        fill="none"
        stroke-linecap="round"
        opacity="0.55"
        filter="url(#pathBlur)"
      />
      <!-- Crisp path line on top -->
      <path
        class="hero__path-line"
        d="M 60 590 C 120 540 200 610 310 572 C 420 534 480 460 600 472 C 720 484 780 540 900 510 C 1020 480 1100 400 1220 418 C 1320 434 1400 475 1500 458"
        stroke="#C4A98A"
        stroke-width="2"
        fill="none"
        stroke-dasharray="6 16"
        stroke-linecap="round"
      />
      <!-- Cream dots along path -->
      <circle class="hero__paw-dot" cx="220" cy="582" r="6"  fill="#F5EFE8" opacity="0.9"/>
      <circle class="hero__paw-dot" cx="400" cy="524" r="5"  fill="#F5EFE8" opacity="0.85"/>
      <circle class="hero__paw-dot" cx="585" cy="468" r="6"  fill="#F5EFE8" opacity="0.9"/>
      <circle class="hero__paw-dot" cx="768" cy="516" r="5"  fill="#F5EFE8" opacity="0.85"/>
      <circle class="hero__paw-dot" cx="950" cy="488" r="6"  fill="#F5EFE8" opacity="0.9"/>
      <circle class="hero__paw-dot" cx="1120" cy="418" r="5" fill="#F5EFE8" opacity="0.85"/>
      <circle class="hero__paw-dot" cx="1300" cy="436" r="6" fill="#F5EFE8" opacity="0.9"/>
      <!-- Gold heart accents floating -->
      <text x="480"  y="195" font-size="14" fill="#C9963B" opacity="0.55">♥</text>
      <text x="980"  y="145" font-size="10" fill="#C9963B" opacity="0.40">♥</text>
      <text x="280"  y="260" font-size="8"  fill="#C9963B" opacity="0.35">♥</text>
    </svg>
  </div>

  <!-- ░░ Main content ░░ -->
  <div class="page-width hero__content">

    <!-- DeskPaws brand title — FULL WIDTH, above the split -->
    <h1 class="hero__brand-name" data-reveal>DeskPaws</h1>

    <!-- Split: text left / cat right -->
    <div class="hero__split">

      <!-- Left: text -->
      <div class="hero__text">
        <p class="hero__eyebrow" data-reveal data-reveal-delay="1">Cozy Spaces,</p>

        <div class="hero__headline-wrap" data-reveal data-reveal-delay="2">
          <h2 class="hero__headline">Happy<br>Paws</h2>
          <i class="hero__headline-heart" aria-hidden="true">♥</i>
        </div>

        <p class="hero__tagline" data-reveal data-reveal-delay="3">
          {{ section.settings.tagline | default: 'Thoughtful cat beds for the coziest naps and happiest purrs.' }}
        </p>

        <div data-reveal data-reveal-delay="4">
          <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
             class="btn btn--dark">
            {{ section.settings.cta_label | default: 'Shop Collection' }}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: animated cat in basket -->
      <div class="hero__visual" data-reveal data-reveal-delay="2">
        <div class="hero__cat-stage" id="catStage">
          <div class="hero__cat-img-wrap" id="catInner">
            {%- if section.settings.hero_image != blank -%}
              <img
                src="{{ section.settings.hero_image | image_url: width: 700 }}"
                alt="{{ section.settings.hero_image.alt | default: 'DeskPaws — cat in desk basket' }}"
                class="hero__cat-img"
                width="700" height="600"
                loading="eager"
                fetchpriority="high"
              >
            {%- else -%}
              <div style="width:100%;aspect-ratio:7/6;background:var(--c-bg-warm);border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;font-size:5rem;">🐱</div>
            {%- endif -%}
          </div>

          <!-- Floating hearts -->
          <i class="hero__heart hero__heart--1" aria-hidden="true">♥</i>
          <i class="hero__heart hero__heart--2" aria-hidden="true">♥</i>
          <i class="hero__heart hero__heart--3" aria-hidden="true">♥</i>
        </div>
      </div>

    </div><!-- /split -->
  </div>

  <!-- ░░ Trust bar ░░ -->
  <div class="hero__trust">
    <div class="page-width">
      <div class="hero__trust-grid">

        <div class="hero__trust-item" data-reveal>
          <span class="hero__trust-icon">🌱</span>
          <div>
            <p class="hero__trust-title">Premium Materials</p>
            <p class="hero__trust-desc">Safe, soft &amp; sustainable</p>
          </div>
        </div>

        <div class="hero__trust-item" data-reveal data-reveal-delay="1">
          <span class="hero__trust-icon">🐾</span>
          <div>
            <p class="hero__trust-title">Cat Approved</p>
            <p class="hero__trust-desc">Loved by cats, trusted by humans</p>
          </div>
        </div>

        <div class="hero__trust-item" data-reveal data-reveal-delay="2">
          <span class="hero__trust-icon" style="color:var(--c-accent);">♥</span>
          <div>
            <p class="hero__trust-title">Made with Love</p>
            <p class="hero__trust-desc">Thoughtful designs for happy naps</p>
          </div>
        </div>

        <div class="hero__trust-item" data-reveal data-reveal-delay="3">
          <span class="hero__trust-icon">🌿</span>
          <div>
            <p class="hero__trust-title">Designed for Comfort</p>
            <p class="hero__trust-desc">Ergonomic, supportive, and cozy</p>
          </div>
        </div>

      </div>
    </div>
  </div>

</section>

{{ 'hero-animation.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Cat in basket image"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Thoughtful cat beds for the coziest naps and happiest purrs."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
