<section class="product-main">
  <div class="page-width product-main__inner">

    <!-- Gallery -->
    <div class="product-main__gallery">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | default: product.title }}"
          width="900" height="900"
          loading="eager"
          style="border-radius:var(--r-lg);"
        >
      {%- endif -%}

      {%- if product.images.size > 1 -%}
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:0.75rem;margin-top:0.75rem;">
          {%- for image in product.images limit: 4 -%}
            <img
              src="{{ image | image_url: width: 200 }}"
              alt="{{ image.alt }}"
              width="200" height="200"
              loading="lazy"
              style="border-radius:var(--r-md);object-fit:cover;aspect-ratio:1;cursor:pointer;"
            >
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="product-main__info">
      <p class="eyebrow" style="margin-bottom:0.5rem;">{{ product.type }}</p>
      <h1 class="product-main__title">{{ product.title }}</h1>

      <p class="product-main__price">
        {%- if product.compare_at_price > product.price -%}
          <s style="color:var(--c-text-soft);font-size:1rem;font-weight:400;">{{ product.compare_at_price | money }}</s>
          &nbsp;
        {%- endif -%}
        {{ product.price | money }}
      </p>

      <div class="product-main__desc rte">{{ product.description }}</div>

      {%- form 'product', product, data-product-form: '' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div style="margin-bottom:1rem;">
              <label style="display:block;font-weight:600;font-size:0.88rem;margin-bottom:0.5rem;">{{ option.name }}</label>
              <select name="options[{{ option.name | escape }}]" style="padding:0.6rem 1rem;border:1px solid var(--c-divider);border-radius:var(--r-md);background:var(--c-bg-card);font-size:0.9rem;width:100%;">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"
                    {%- if option.selected_value == value %} selected{% endif -%}>
                    {{ value }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
          <select name="id" style="display:none;">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"
                {%- if variant == product.selected_or_first_available_variant %} selected{% endif -%}>
                {{ variant.title }}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endunless -%}

        <div style="margin-bottom:1.5rem;">
          <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.85rem;cursor:pointer;">
            <input type="number" name="quantity" value="1" min="1"
              style="width:56px;padding:0.5rem;border:1px solid var(--c-divider);border-radius:var(--r-sm);text-align:center;">
            Quantity
          </label>
        </div>

        <button
          type="submit"
          class="btn btn--dark product-form__submit"
          data-add-to-cart
          data-default-text="Add to Cart — {{ product.price | money }}"
          {%- unless product.available %} disabled{% endunless -%}
        >
          {%- if product.available -%}
            Add to Cart — {{ product.price | money }}
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      {%- endform -%}

      <!-- Trust mini -->
      <div style="display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--c-divider);">
        <span style="font-size:0.82rem;color:var(--c-text-mid);">🚚 Free shipping over $75</span>
        <span style="font-size:0.82rem;color:var(--c-text-mid);">↩️ 30-day returns</span>
        <span style="font-size:0.82rem;color:var(--c-text-mid);">🐾 Cat approved</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product"
}
{% endschema %}
