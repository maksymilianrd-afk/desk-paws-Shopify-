<section class="cart-main">
  <div class="page-width">
    <h1>Your Cart</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p style="font-size:3rem;margin-bottom:1rem;">🛒</p>
        <p>Your cart is empty — your cat's new nap spot is waiting.</p>
        <a href="/collections/all" class="btn btn--dark">Shop DeskPaws</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div style="display:flex;gap:1.5rem;align-items:center;padding:1.5rem 0;border-bottom:1px solid var(--c-divider);">
            <a href="{{ item.url }}">
              <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" width="80" height="80" style="border-radius:var(--r-md);object-fit:cover;">
            </a>
            <div style="flex:1;">
              <p style="font-weight:600;margin-bottom:0.25rem;">{{ item.product.title }}</p>
              {%- unless item.variant.title == 'Default Title' -%}
                <p style="font-size:0.85rem;color:var(--c-text-mid);">{{ item.variant.title }}</p>
              {%- endunless -%}
              <p style="color:var(--c-text-mid);font-size:0.9rem;">{{ item.price | money }}</p>
            </div>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <label class="visually-hidden" for="qty-{{ item.key }}">Quantity</label>
              <input
                type="number"
                id="qty-{{ item.key }}"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                style="width:60px;padding:0.4rem 0.6rem;border:1px solid var(--c-divider);border-radius:var(--r-sm);text-align:center;"
              >
              <a href="{{ routes.cart_url }}/change?line={{ forloop.index }}&amp;quantity=0"
                 style="font-size:0.8rem;color:var(--c-text-soft);">Remove</a>
            </div>
            <p style="font-weight:700;min-width:80px;text-align:right;">{{ item.final_line_price | money }}</p>
          </div>
        {%- endfor -%}

        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:1rem;padding-top:2rem;">
          <p style="font-size:1.2rem;font-weight:700;">Total: {{ cart.total_price | money }}</p>
          <button type="submit" name="checkout" class="btn btn--dark" style="font-size:1rem;padding:1rem 2.5rem;">
            Checkout →
          </button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}
