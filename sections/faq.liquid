<section class="faq" data-section-id="{{ section.id }}">
  <div class="page-width faq__inner">

    <div class="faq__sidebar">
      <p class="eyebrow" data-reveal>Got Questions?</p>
      <h2 data-reveal data-reveal-delay="1">
        {{ section.settings.title | default: 'We Have Answers' }}
      </h2>
      <p data-reveal data-reveal-delay="2">
        {{ section.settings.subtitle | default: 'Everything you need to know before your cat claims their new favourite spot.' }}
      </p>
      <a href="{{ section.settings.contact_url | default: '/pages/contact' }}" class="faq__contact-link" data-reveal data-reveal-delay="3">
        Still have questions? Chat with us →
      </a>
    </div>

    <div class="faq__list" role="list">

      {%- if section.blocks.size > 0 -%}

        {%- for block in section.blocks -%}
          <div class="faq-item" role="listitem" {{ block.shopify_attributes }}>
            <button
              class="faq-item__trigger"
              aria-expanded="false"
              aria-controls="faq-body-{{ block.id }}"
            >
              {{ block.settings.question | default: 'What desks does it fit?' }}
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-item__body" id="faq-body-{{ block.id }}" role="region">
              {{ block.settings.answer | default: 'DeskPaws fits any desk with an edge thickness between 0.5 and 2.5 inches.' }}
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}

        <div class="faq-item" role="listitem">
          <button class="faq-item__trigger" aria-expanded="false">
            What desk types does it fit?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__body">
            DeskPaws clamps onto any straight desk edge between 0.5 and 2.5 inches thick — including IKEA desks, adjustable standing desks, and most glass desks with the included adapter pad.
          </div>
        </div>

        <div class="faq-item" role="listitem">
          <button class="faq-item__trigger" aria-expanded="false">
            How much weight can it hold?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__body">
            The steel-core clamp system is rated to 20 lbs (9 kg). Most domestic cats weigh 8–10 lbs so you will have plenty of headroom.
          </div>
        </div>

        <div class="faq-item" role="listitem">
          <button class="faq-item__trigger" aria-expanded="false">
            Is the liner machine washable?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__body">
            Yes! Unzip the liner and toss it in the machine on a gentle cool cycle. It air-dries in a few hours and comes out fluffy and fresh.
          </div>
        </div>

        <div class="faq-item" role="listitem">
          <button class="faq-item__trigger" aria-expanded="false">
            Will my cat actually use it?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__body">
            Most cats adopt it within 1–3 days. A small amount of catnip sprinkled inside works wonders. We have never had a cat that ignored it for more than a week.
          </div>
        </div>

        <div class="faq-item" role="listitem">
          <button class="faq-item__trigger" aria-expanded="false">
            How long does shipping take?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__body">
            Orders ship within 1–2 business days. Standard delivery is 3–7 days (US). Express 1–2 day options are available at checkout.
          </div>
        </div>

        <div class="faq-item" role="listitem">
          <button class="faq-item__trigger" aria-expanded="false">
            Do you offer a returns policy?
            <span class="faq-item__icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-item__body">
            We offer a 30-day happiness guarantee — if your cat does not love it we will refund you in full. No questions asked.
          </div>
        </div>

      {%- endif -%}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "We Have Answers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtext",
      "default": "Everything you need to know before your cat claims their new favourite spot."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page URL"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer",   "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "FAQ" }
  ]
}
{% endschema %}
