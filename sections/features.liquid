<section class="features" data-section-id="{{ section.id }}">
  <div class="page-width features__inner">

    <!-- Text + feature list -->
    <div class="features__text">
      <p class="eyebrow" data-reveal>Why DeskPaws</p>
      <h2 data-reveal data-reveal-delay="1">
        {{ section.settings.title | default: 'Built for Cats.<br>Loved by Owners.' }}
      </h2>
      <p data-reveal data-reveal-delay="2">
        {{ section.settings.subtitle | default: 'Every detail of the DeskPaws Bucket was obsessed over — from the plush that mimics a cat parent's lap to the steel-core clamp that never wobbles.' }}
      </p>

      <div class="features__list" data-reveal data-reveal-delay="3">

        <div class="feature-row">
          <div class="feature-row__icon">🧶</div>
          <div>
            <p class="feature-row__title">Premium Sherpa Fleece</p>
            <p class="feature-row__desc">Hypoallergenic, extra-dense pile that stays warm without trapping odours. Machine washable.</p>
          </div>
        </div>

        <div class="feature-row">
          <div class="feature-row__icon">🔩</div>
          <div>
            <p class="feature-row__title">Steel-core Clamp System</p>
            <p class="feature-row__desc">Rated to 20 lbs. Silicone padding protects your desk finish while keeping the bucket rock-solid.</p>
          </div>
        </div>

        <div class="feature-row">
          <div class="feature-row__icon">📐</div>
          <div>
            <p class="feature-row__title">Ergonomic Bowl Shape</p>
            <p class="feature-row__desc">The curved interior supports the natural curl cats sleep in — no flat mats, no awkward angles.</p>
          </div>
        </div>

        <div class="feature-row">
          <div class="feature-row__icon">🌱</div>
          <div>
            <p class="feature-row__title">Responsibly Sourced</p>
            <p class="feature-row__desc">Recycled polyester fill, azo-free dyes, and packaging made from 100% recycled cardboard.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Visual grid -->
    <div class="features__visual" data-reveal data-reveal-delay="2">

      <div class="features__img-card">
        {%- if section.settings.image_1 != blank -%}
          <img src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="{{ section.settings.image_1.alt }}" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:var(--c-bg);display:flex;align-items:center;justify-content:center;font-size:3rem;">🐾</div>
        {%- endif -%}
      </div>

      <div class="features__img-card">
        {%- if section.settings.image_2 != blank -%}
          <img src="{{ section.settings.image_2 | image_url: width: 800 }}" alt="{{ section.settings.image_2.alt }}" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:var(--c-bg);display:flex;align-items:center;justify-content:center;font-size:3rem;">😴</div>
        {%- endif -%}
      </div>

      <div class="features__img-card">
        {%- if section.settings.image_3 != blank -%}
          <img src="{{ section.settings.image_3 | image_url: width: 800 }}" alt="{{ section.settings.image_3.alt }}" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:var(--c-bg);display:flex;align-items:center;justify-content:center;font-size:3rem;">♥</div>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Built for Cats. Loved by Owners."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtext",
      "default": "Every detail of the DeskPaws Bucket was obsessed over — from the plush that mimics a cat parent's lap to the steel-core clamp that never wobbles."
    },
    { "type": "image_picker", "id": "image_1", "label": "Feature image 1 (wide)" },
    { "type": "image_picker", "id": "image_2", "label": "Feature image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Feature image 3" }
  ],
  "presets": [
    { "name": "Features" }
  ]
}
{% endschema %}
