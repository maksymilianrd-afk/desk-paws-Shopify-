<section class="how-it-works" data-section-id="{{ section.id }}">
  <div class="page-width">

    <div class="how-it-works__header">
      <p class="eyebrow" data-reveal>Simple Setup</p>
      <h2 data-reveal data-reveal-delay="1">
        {{ section.settings.title | default: 'Ready in Three Steps' }}
      </h2>
    </div>

    <div class="how-it-works__steps">

      <div class="step-card" data-reveal data-reveal-delay="1">
        <span class="step-card__emoji">{{ section.settings.step_1_emoji | default: '🔧' }}</span>
        <div class="step-card__number">1</div>
        <h3 class="step-card__title">{{ section.settings.step_1_title | default: 'Clamp It On' }}</h3>
        <p class="step-card__desc">{{ section.settings.step_1_desc | default: 'Attach the non-scratch clamp to any desk edge up to 2.5 inches thick — no tools needed.' }}</p>
      </div>

      <div class="step-card" data-reveal data-reveal-delay="2">
        <span class="step-card__emoji">{{ section.settings.step_2_emoji | default: '🐱' }}</span>
        <div class="step-card__number">2</div>
        <h3 class="step-card__title">{{ section.settings.step_2_title | default: 'Set Your Cat Inside' }}</h3>
        <p class="step-card__desc">{{ section.settings.step_2_desc | default: 'Your cat will discover it in minutes. A little catnip helps too.' }}</p>
      </div>

      <div class="step-card" data-reveal data-reveal-delay="3">
        <span class="step-card__emoji">{{ section.settings.step_3_emoji | default: '😴' }}</span>
        <div class="step-card__number">3</div>
        <h3 class="step-card__title">{{ section.settings.step_3_title | default: 'Watch Them Nap' }}</h3>
        <p class="step-card__desc">{{ section.settings.step_3_desc | default: 'Sit back and enjoy the warmest co-worker you have ever had.' }}</p>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "Ready in Three Steps"
    },
    { "type": "text",     "id": "step_1_emoji", "label": "Step 1 — Emoji",        "default": "🔧" },
    { "type": "text",     "id": "step_1_title", "label": "Step 1 — Title",        "default": "Clamp It On" },
    { "type": "textarea", "id": "step_1_desc",  "label": "Step 1 — Description",  "default": "Attach the non-scratch clamp to any desk edge up to 2.5 inches thick — no tools needed." },
    { "type": "text",     "id": "step_2_emoji", "label": "Step 2 — Emoji",        "default": "🐱" },
    { "type": "text",     "id": "step_2_title", "label": "Step 2 — Title",        "default": "Set Your Cat Inside" },
    { "type": "textarea", "id": "step_2_desc",  "label": "Step 2 — Description",  "default": "Your cat will discover it in minutes. A little catnip helps too." },
    { "type": "text",     "id": "step_3_emoji", "label": "Step 3 — Emoji",        "default": "😴" },
    { "type": "text",     "id": "step_3_title", "label": "Step 3 — Title",        "default": "Watch Them Nap" },
    { "type": "textarea", "id": "step_3_desc",  "label": "Step 3 — Description",  "default": "Sit back and enjoy the warmest co-worker you have ever had." }
  ],
  "presets": [
    { "name": "How It Works" }
  ]
}
{% endschema %}
